# @BotFather orqali olingan tokenni kiriting. Tokenni boshqalarga yubormang.
BOT_TOKEN=
# Ixtiyoriy: ruxsat berilgan Telegram user ID lar, vergul bilan.
# Bo'sh bo'lsa barcha shaxsiy chatlarga ruxsat beriladi.
ALLOWED_USER_IDS=
BUILD_COOLDOWN_SECONDS=60
MAX_PENDING_BUILDS=5

# Ixtiyoriy Authenticode. Ishonchli code-signing sertifikati oldindan o'rnatiladi.
# Sertifikat thumbprint'i (40 hex belgi); bo'sh bo'lsa EXE imzosiz yaratiladi.
SIGN_CERT_SHA1=
SIGN_CERT_STORE=CurrentUser
# Windows SDK ichidagi signtool.exe; bo'sh bo'lsa avtomatik qidiriladi.
SIGNTOOL_PATH=
SIGN_TIMESTAMP_URL=http://timestamp.digicert.com
# 1: imzolash sozlanmaguncha bot/build ishga tushmaydi.
REQUIRE_SIGNED_BUILDS=0
